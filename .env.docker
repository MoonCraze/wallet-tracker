# Production Environment Con# Development Features (enable for testing)
ALLOW_DEV_ENDPOINTS=trueguration

# Database Configuration
DATABASE_URL="file:./data/production.db"

# Server Configuration
PORT=8080
NODE_ENV=production
ALLOWED_ORIGINS="*"

# Webhook Security
WEBHOOK_SECRET=super-secret-production-key

# Transaction Filtering
EXCLUDE_TOKENS="So11111111111111111111111111111111111111112,EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v,Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB"
MIN_AMOUNT=1

# Coordinated Trade Detection
COORDINATED_WINDOW_MINUTES=5
COORDINATED_MIN_WALLETS=5

# Deduplication Strategy
DEDUP_BY_SIGNATURE_ONLY=false

# Debug Configuration (disabled for production)
DEBUG_EVENTS=false
DEBUG_EVENTS_VERBOSE=false

# Development Features (disabled for production)
ALLOW_DEV_ENDPOINTS=false
