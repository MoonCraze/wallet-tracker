############################
# Copy to .env and fill in values
############################

############################
# Helius webhook updater
############################
# Either HELIUS_API_KEY or HELlUS_API_KEY (legacy typo) is accepted
HELIUS_API_KEY=
WEBHOOK_ID=
# Public HTTPS URL to your /helius route (e.g. Cloudflared tunnel)
WEBHOOK_URL=
WEBHOOK_SECRET=super-secret

############################
# Database (SQLite by default)
############################
DATABASE_URL="file:./prisma/dev.db"

############################
# Server
############################
PORT=8080

############################
# CORS Configuration for Cross-Origin Access
############################
# Comma-separated list of allowed origins, or use * for all origins
# Examples:
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com,https://anotherdomain.com
# ALLOWED_ORIGINS=*
# For development, use * to allow all origins:
ALLOWED_ORIGINS=*

# Enable development endpoints (set to 1 or true)
ALLOW_DEV_ENDPOINTS=1

############################
# Logging
############################
# Set 1 to log webhook request summaries and parsed samples
DEBUG_EVENTS=0
# Set 1 to also log skip/filter details and duplicate info
DEBUG_EVENTS_VERBOSE=0

############################
# Whale-tracking filters
############################
# Comma-separated list of token mints to exclude from saving. By default excludes
# WSOL mint (SOL): So11111111111111111111111111111111111111112
EXCLUDE_TOKENS=So11111111111111111111111111111111111111112
# Minimum absolute amount to save (decimal). Default 1
MIN_AMOUNT=1
# Optional: treat signature as unique regardless of wallet/token
DEDUP_BY_SIGNATURE_ONLY=0

############################
# Coordinated trading detection
############################
# Window in minutes to detect coordinated buys
COORDINATED_WINDOW_MINUTES=5
# Minimum unique wallets buying the same token within the window to trigger
COORDINATED_MIN_WALLETS=5