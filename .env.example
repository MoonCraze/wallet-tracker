# Copy to .env and fill in values
HELIUS_API_KEY=61b58579-ec84-4581-a562-37f57e5fc154
# WEBHOOK_ID=
WEBHOOK_URL=https://helius.wonderswhisper.com/helius
WEBHOOK_SECRET=super-secret

# Database (SQLite by default) for Prisma
DATABASE_URL="file:./dev.db"


############################
# Wallets source (MySQL well_performed)
############################
# MySQL connection string to the source DB having table `well_performed(wallet_address, ...)`.
# Example:
# WALLETS_DATABASE_URL="mysql://user:pass@host:22367/solana_tokens?sslaccept=accept_invalid_certs"
WALLETS_DATABASE_URL="mysql://avnadmin:AVNS_s_SZfyOg-HwfeBk01DK@mysql-1203e9ea-doodrops-32c6.c.aivencloud.com:22367/solana_tokens?sslaccept=accept_invalid_certs"

############################
# Wallets API Endpoint (Daily Sync)
############################
# API endpoint to fetch top 100 performing wallets daily at midnight
# The endpoint should return an array of wallet data objects
# Example: https://api.example.com/wallets/top-performers
WALLETS_API_ENDPOINT=https://your-api-endpoint.com/top-wallets

############################
# CORS Configuration for Cross-Origin Access
############################
# Comma-separated list of allowed origins, or use * for all origins
# Examples:
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com,https://anotherdomain.com
# ALLOWED_ORIGINS=*
# For development, use * to allow all origins:
ALLOWED_ORIGINS=*

# Enable development endpoints (set to 1 or true)
ALLOW_DEV_ENDPOINTS=1


# Wallets source (MySQL) — used to load 100 wallets/day from well_performed.wallet_address
# Provide a MySQL URL here to avoid clashing with Prisma's DATABASE_URL
# Example:
# WALLETS_DATABASE_URL="mysql://user:pass@host:22367/solana_tokens?sslaccept=accept_invalid_certs"
WALLETS_DATABASE_URL="mysql://avnadmin:AVNS_s_SZfyOg-HwfeBk01DK@mysql-1203e9ea-doodrops-32c6.c.aivencloud.com:22367/solana_tokens?sslaccept=accept_invalid_certs"
WALLETS_TABLE=well_performed

# Server
PORT=8080

# Set 1 to log webhook request summaries and parsed samples
DEBUG_EVENTS=0
# Set 1 to also log skip/filter details and duplicate info
DEBUG_EVENTS_VERBOSE=0

############################
# Whale-tracking filters
############################
# Comma-separated list of token mints to exclude from saving. By default excludes
# WSOL mint (SOL): So11111111111111111111111111111111111111112
EXCLUDE_TOKENS=So11111111111111111111111111111111111111112
# Minimum absolute amount to save (decimal). Default 1
MIN_AMOUNT=1
# Optional: treat signature as unique regardless of wallet/token
DEDUP_BY_SIGNATURE_ONLY=0


############################
# Coordinated trading detection
############################
# Window in minutes to detect coordinated buys
COORDINATED_WINDOW_MINUTES=5
# Minimum unique wallets buying the same token within the window to trigger
COORDINATED_MIN_WALLETS=5

ALLOW_DEV_ENDPOINTS=1