# Database Configuration
DATABASE_URL="file:./prisma/dev.db"

# Server Configuration
PORT=8080
NODE_ENV=development
ALLOWED_ORIGINS="*"

# Webhook Security
WEBHOOK_SECRET="super-secret"

# Optional: Helius API Configuration (for webhook setup script)
# HELIUS_API_KEY="your-helius-api-key"
# WEBHOOK_URL="https://your-domain.com"

# Transaction Filtering
EXCLUDE_TOKENS="So11111111111111111111111111111111111111112"
MIN_AMOUNT=1

# Coordinated Trade Detection
COORDINATED_WINDOW_MINUTES=5
COORDINATED_MIN_WALLETS=5

# Deduplication Strategy
DEDUP_BY_SIGNATURE_ONLY=false

# Debug Configuration
DEBUG_EVENTS=false
DEBUG_EVENTS_VERBOSE=false

# Development Features (disable in production)
ALLOW_DEV_ENDPOINTS=false