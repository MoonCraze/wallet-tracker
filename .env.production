# Sample Production Environment Configuration
# This is a working example - replace with your actual values

# Helius Configuration
HELIUS_API_KEY=6328e915-75c7-4dd1-b8d2-c534a2b040b3
WEBHOOK_URL=https://helius.wonderswhisper.com/helius
WEBHOOK_SECRET=helius-production-secret-2025

# Database Configuration
DATABASE_URL=file:/app/data/production.db

############################
# CORS Configuration for Cross-Origin Access
############################
# Comma-separated list of allowed origins, or use * for all origins
# Examples:
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com,https://anotherdomain.com
# ALLOWED_ORIGINS=*
# For development, use * to allow all origins:
ALLOWED_ORIGINS=*

# Enable development endpoints (set to 1 or true)
ALLOW_DEV_ENDPOINTS=1


# Server Configuration
NODE_ENV=production
PORT=8080

# Filter Configuration
EXCLUDE_TOKENS=So11111111111111111111111111111111111111112
MIN_AMOUNT=1
DEDUP_BY_SIGNATURE_ONLY=0

# Coordination Detection
COORDINATED_WINDOW_MINUTES=5
COORDINATED_MIN_WALLETS=3

# Debug Configuration (set to 0 for production)
DEBUG_EVENTS=1
DEBUG_EVENTS_VERBOSE=0

# Development endpoints (enable for demo)
ALLOW_DEV_ENDPOINTS=1
