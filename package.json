{
  "name": "helius-wallet-tracker",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "start": "node dist/app.js",
    "build": "tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:test": "tsx scripts/testConnection.ts",
    "db:setup-timescale": "tsx scripts/finalTimescaleSetup.ts",
    "webhook:update": "tsx scripts/updateWebhook.ts",
    "wallets:sync": "tsx scripts/syncWallets.ts",
    "docker:build": "docker build -t helius-wallet-tracker .",
    "docker:run": "docker run -p 8080:8080 --env-file .env.production helius-wallet-tracker",
    "prod:logs": "docker-compose --env-file .env.production logs -f",
    "prod:stop": "docker-compose --env-file .env.production down",
    "prod:restart": "docker-compose --env-file .env.production restart"
  },
  "dependencies": {
    "@prisma/client": "^5.16.1",
    "@types/cors": "^2.8.19",
    "@types/pg": "^8.16.0",
    "axios": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "prisma": "^5.16.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.11",
    "@types/ws": "^8.5.12",
    "tsx": "^4.15.7",
    "typescript": "^5.5.4"
  }
}
