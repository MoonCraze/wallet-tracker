generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model TransferEvent {
  id            String   @id @default(cuid())
  walletAddress String
  tokenAddress  String
  amount        String   // store as string to avoid FP precision issues
  signature     String   // Solana transaction signature
  timestamp     DateTime
  side          String   // "BUY" | "SELL"

  // Composite unique constraint: A single transaction (signature) can contain
  // multiple token transfers. Each (wallet, token, signature) is unique.
  // Example: Wallet selling 10 different tokens = 1 signature, 10 records
  @@unique([walletAddress, tokenAddress, signature], name: "wallet_token_sig_unique")
  @@index([walletAddress, timestamp])
  @@index([tokenAddress, timestamp])
  @@index([signature])
}

// Stores coordinated trading detection events over a rolling 5-minute bucket
model CoordinatedTrade {
  id                String   @id @default(cuid())
  tokenAddress      String
  windowStart       DateTime // inclusive bucket start
  windowEnd         DateTime // exclusive bucket end
  triggeredAt       DateTime // when we detected/recorded it
  uniqueWalletCount Int
  walletAddresses   String   // JSON array of wallet addresses that bought within window

  @@index([tokenAddress, windowStart])
  @@unique([tokenAddress, windowStart], name: "token_window_unique")
}